#%RAML 1.0
title: MyBestSim Integration API
version: v1
baseUri: http://localhost:8081/api/v1
mediaType: application/json
protocols: [HTTP, HTTPS]
description: |
  Read-only catalogue statistics computed from PostgreSQL, plus a protected endpoint to trigger
  the CSV import. The API never exposes database identifiers or local file-system paths.

  **Statistic rules**
  - `priceAvg`: arithmetic mean of `price` over ALL products (unlimited offers included).
  - `dataAvgGb`: arithmetic mean of `data_gb` over products with a numeric allowance only
    (unlimited offers excluded; they are counted separately in `unlimitedCount`).
  - `productsOver100`: products whose price is strictly greater than 100 (catalogue currency).
  - On an empty database every count is 0 and every min/max/average is `null`; `hasData` is `false`.

securitySchemes:
  adminApiKey:
    description: Shared secret sent in the `X-API-Key` header (admin operations only).
    type: x-api-key
    describedBy:
      headers:
        X-API-Key:
          type: string
          required: false
      responses:
        401:
          description: Missing or invalid API key.

types:
  Error:
    type: object
    properties:
      error:
        type: object
        properties:
          code: string
          message: string
    example:
      error:
        code: BAD_REQUEST
        message: "Invalid query parameter"
  Summary:
    type: object
    properties:
      hasData: boolean
      totalProducts: integer
      productsOver100: integer
      priceMin: { type: number, required: false }
      priceMax: { type: number, required: false }
      priceAvg: { type: number, required: false }
      dataAvgGb: { type: number, required: false }
      numericDataCount: integer
      unlimitedCount: integer
      providerCount: integer
      countryCount: integer
      currency: { type: string, required: false }
  ProviderStat:
    type: object
    properties:
      provider: string
      productCount: integer
      sharePercent: number
      priceAvg: number
      priceMin: number
      priceMax: number
      unlimitedCount: integer
  PriceBucket:
    type: object
    properties:
      label: string
      min: number
      max: { type: number, required: false }
      count: integer
  DataBucket:
    type: object
    properties:
      label: string
      dataGb: { type: number, required: false }
      isUnlimited: boolean
      count: integer
  CountBucket:
    type: object
    properties:
      label: string
      count: integer
  Product:
    type: object
    properties:
      sku: string
      provider: string
      productName: string
      countryCode: string
      countryName: string
      dataGb: { type: number, required: false }
      dataDisplay: string
      isUnlimited: boolean
      validityDays: integer
      price: number
      currency: string
      network: string
      topUp: boolean
  ProductPage:
    type: object
    properties:
      items: Product[]
      page: integer
      pageSize: integer
      totalItems: integer
      totalPages: integer
  ImportRun:
    type: object
    properties:
      sourceFile: string
      status: { enum: [RUNNING, SUCCESS, PARTIAL, FAILED] }
      startedAt: datetime
      finishedAt: { type: datetime, required: false }
      rowsRead: integer
      rowsInserted: integer
      rowsUpdated: integer
      rowsRejected: integer
      errorMessage: { type: string, required: false }
  ImportFileResult:
    type: object
    properties:
      sourceFile: string
      status: { enum: [SUCCESS, PARTIAL, FAILED] }
      rowsRead: integer
      rowsInserted: integer
      rowsUpdated: integer
      rowsRejected: integer
      errorMessage: { type: string, required: false }
  LatestImport:
    type: object
    properties:
      hasImport: boolean
      batchId: { type: string, required: false }
      status: { type: string, required: false }
      trigger: { type: string, required: false }
      startedAt: { type: datetime, required: false }
      finishedAt: { type: datetime, required: false }
      filesCount: integer
      rowsRead: integer
      rowsInserted: integer
      rowsUpdated: integer
      rowsRejected: integer
      runs: ImportRun[]
  ImportResult:
    type: object
    properties:
      batchId: { type: string, required: false }
      status: string
      filesFound: integer
      filesProcessed: integer
      rowsRead: integer
      rowsInserted: integer
      rowsUpdated: integer
      rowsRejected: integer
      files: ImportFileResult[]

/dashboard:
  /summary:
    get:
      description: Global KPIs computed from PostgreSQL.
      responses:
        200:
          body:
            application/json:
              type: Summary
  /providers:
    get:
      description: Product count and price statistics per provider.
      responses:
        200:
          body:
            application/json:
              type: object
              properties:
                items: ProviderStat[]
  /prices:
    get:
      description: Price distribution in fixed buckets (empty buckets are returned with count 0).
      responses:
        200:
          body:
            application/json:
              type: object
              properties:
                currency: { type: string, required: false }
                buckets: PriceBucket[]
  /data:
    get:
      description: Data allowance, validity and network distributions.
      responses:
        200:
          body:
            application/json:
              type: object
              properties:
                dataDistribution: DataBucket[]
                validityDistribution: CountBucket[]
                networkDistribution: CountBucket[]
/products:
  get:
    description: Filtered, sorted and server-paginated catalogue.
    queryParameters:
      page: { type: integer, minimum: 1, default: 1, required: false }
      pageSize: { type: integer, minimum: 1, maximum: 100, default: 25, required: false }
      provider: { type: string, required: false }
      country: { type: string, required: false, description: "Country code, e.g. FR" }
      network: { enum: ["2G", "3G", "4G", "5G"], required: false }
      unlimited: { type: boolean, required: false }
      topUp: { type: boolean, required: false }
      minPrice: { type: number, minimum: 0, required: false }
      maxPrice: { type: number, minimum: 0, required: false }
      q: { type: string, required: false, maxLength: 100, description: "Case-insensitive search in product name, SKU and country" }
      sort: { enum: [price, dataGb, validityDays, productName, provider, country], default: price, required: false }
      direction: { enum: [asc, desc], default: asc, required: false }
    responses:
      200:
        body:
          application/json:
            type: ProductPage
      400:
        body:
          application/json:
            type: Error
/imports:
  post:
    description: |
      Triggers an import of every CSV currently in the configured source directory (synchronous).
      Protected by the `X-API-Key` header.
    securedBy: [adminApiKey]
    responses:
      200:
        body:
          application/json:
            type: ImportResult
      401:
        body:
          application/json:
            type: Error
      409:
        description: An import is already running.
        body:
          application/json:
            type: Error
      503:
        description: Database or source directory not ready (migrations not applied, unreachable...).
        body:
          application/json:
            type: Error
  /latest:
    get:
      description: Status of the most recent import batch (one entry per processed file).
      responses:
        200:
          body:
            application/json:
              type: LatestImport
